{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hr-system",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  // The only public address is the custom domain, declared here so every deploy keeps it attached.
  // hr-systems.siamhrbp.com actually reaches the Worker through a proxied DNS record that points at the workers.dev
  // URL (requests arrive with the workers.dev host and cf-worker: siamhrbp.com). Do NOT set workers_dev / preview_urls
  // to false: on 2026-11-18 that stopped the main domain from serving
  // (Cloudflare 404 for ~7 minutes). The *.workers.dev URL stays enabled and the Worker redirects it (301) to the
  // custom domain instead (src/worker/index.ts, workersDevRedirect) — which is why run_worker_first is true.
  "routes": [{ "pattern": "hr-systems.siamhrbp.com", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hr-system-db",
      "database_id": "ba67e6d1-61b6-44f7-8922-49401a2cb295",
      "migrations_dir": "migrations"
    }
  ],
  // Employee photographs: private bucket (no r2.dev URL, no custom domain); the Worker is the only way in and checks
  // the session, RBAC and row scope on every read. Locally, wrangler dev simulates the bucket.
  "r2_buckets": [
    {
      "binding": "AVATARS",
      "bucket_name": "hr-system-employee-assets"
    }
  ],
  // Non-secret configuration. Secrets (MFA_ENCRYPTION_KEY) are set with `wrangler secret put`
  // and, for local development, in .dev.vars (git-ignored).
  "vars": {
    "APP_NAME": "HR System",
    "APP_BASE_PATH": ""
  },
  // probation job (src/worker/lib/probation-job.ts): 00:05 and 08:05 Asia/Bangkok; the second run is the retry
  "triggers": { "crons": ["5 17 * * *", "5 1 * * *"] },
  "observability": { "enabled": true }
}
